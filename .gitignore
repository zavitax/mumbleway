# Root ignores only cover things Flutter's own per-platform .gitignore files do
# not: the Rust build output, Dart tooling, editor droppings and secrets.
#
# Deliberately no rules for app/{macos,ios,windows,android}/**. Each of those
# directories ships its own .gitignore generated by `flutter create`, and those
# are authoritative. Hand-written rules here previously excluded
# macos/Flutter/Flutter-Release.xcconfig, which is a *committed* project file,
# and the macOS build failed with "could not find included file".

# --- Rust ------------------------------------------------------------------
target/
**/target/

# --- Flutter / Dart --------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.symbols
app.*.map.json

# --- Editors / OS ----------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- Secrets ---------------------------------------------------------------
# The client identity certificate is generated per-install into the user's
# application-support directory. It must never end up in version control:
# Mumble servers tie account registration to it.
*.pem
identity.crt
identity.key
key.properties
*.jks
*.keystore
