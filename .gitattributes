# Normalise to LF in the repository. This matters for CI: cargokit's build
# scripts are executed on the macOS and Linux runners, and a CRLF shebang line
# makes them fail with a confusing "bad interpreter" error.
* text=auto eol=lf

*.sh        text eol=lf
*.podspec   text eol=lf
*.cmake     text eol=lf

# Windows-only scripts keep CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary assets.
*.png       binary
*.jpg       binary
*.ico       binary
*.ttf       binary
*.jar       binary
*.keystore  binary
