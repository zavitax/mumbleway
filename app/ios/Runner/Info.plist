<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mumbleway</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mumbleway</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Required before iOS will grant microphone access. -->
	<!-- Mumble servers are very often on the same network as the rider: a
	     bike-club box at the clubhouse, or one running on a laptop. iOS blocks
	     connections to local addresses unless the app says why it wants them,
	     and the block is immediate, so it presents as a server that refuses
	     the connection rather than as a permission that was never asked for. -->
	<!-- Export compliance. False here does not say the app has no encryption.
	     The key asks about NON-EXEMPT encryption specifically, and Apple's own
	     wording for it ("specify that you don't use encryption") is shorthand
	     that reads as the opposite of what the key means. The app does encrypt:
	     the voice path uses AES-128 under OCB2 implemented in this repository,
	     and the control channel runs TLS from a library compiled into the
	     binary. Those facts are unchanged by this setting.

	     It is false because App Store Connect's export questionnaire, answered
	     for this app, returned "you don't need to upload any documents" and
	     directed that the key be set accordingly. That questionnaire result —
	     in App Store Connect under App Information — is the record, not this
	     file. A build whose plist disagrees with it is rejected on upload with
	     error 90592, which is how the mismatch surfaced.

	     So this key is a mirror of a determination made elsewhere. If the
	     cryptography changes, the questionnaire has to be answered again
	     before this value can be trusted; do not reason from this comment
	     alone. See docs/RELEASING.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MumbleWay connects to Mumble servers on your network, such as one running at home or at a club.</string>
	<!-- Only ever asked for when the rider taps the scan button; the camera is
	     not opened anywhere else in the app, and this says so. -->
	<key>NSCameraUsageDescription</key>
	<string>MumbleWay uses the camera to scan a QR code containing a server invitation. It is not used for anything else.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MumbleWay uses your microphone so you can talk to other riders.</string>
	<!-- Voice must keep flowing with the screen locked and the phone in a
	     pocket or handlebar mount, so the app runs as background audio. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- Invitation links, and how a code scanned by the Camera app reaches us:
	     it recognises the scheme and offers to open whatever claims it. The
	     role is Viewer rather than Editor because this is Mumble's scheme, not
	     ours — several clients answer to it and none of them owns it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.mumbleway.mumbleway.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mumble</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
