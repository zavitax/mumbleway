<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- Required for the Mac App Store, which rejects an upload without it.
	     Social networking is the closest of Apple's fixed list to a group
	     voice channel; there is no "communication" category on macOS. This is
	     the shelf the app is listed on, so it is worth a second opinion. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<!-- Required on macOS 10.14 and later, and the sandbox entitlement is not
	     a substitute: the entitlement decides whether the app may ask, this
	     decides whether the system lets it. Without it macOS terminates the
	     process the moment it touches the microphone, which reads as a crash
	     on connect rather than as a missing plist key. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MumbleWay uses your microphone so you can talk to other riders.</string>
	<!-- Export compliance. False here does not say the app has no encryption.
	     The key asks about NON-EXEMPT encryption specifically, and Apple's own
	     wording for it ("specify that you don't use encryption") is shorthand
	     that reads as the opposite of what the key means. The app does encrypt:
	     the voice path uses AES-128 under OCB2 implemented in this repository,
	     and the control channel runs TLS from a library compiled into the
	     binary. Those facts are unchanged by this setting.

	     It is false because App Store Connect's export questionnaire, answered
	     for this app, returned "you don't need to upload any documents" and
	     directed that the key be set accordingly. That questionnaire result —
	     in App Store Connect under App Information — is the record, not this
	     file. A build whose plist disagrees with it is rejected on upload with
	     error 90592, which is how the mismatch surfaced.

	     So this key is a mirror of a determination made elsewhere. If the
	     cryptography changes, the questionnaire has to be answered again
	     before this value can be trusted; do not reason from this comment
	     alone. See docs/RELEASING.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
