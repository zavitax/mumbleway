<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice capture and network transport. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- A rider's phone screens off in a pocket or mount; without a foreground
         service Android suspends the process and the connection drops. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Bluetooth helmet intercoms are the normal audio route for this app. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- The floating push-to-talk island draws over the navigation app the
         rider is actually looking at. Granted by the user in system settings;
         the app works without it, just without the island. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Scanning an invitation code, and nothing else. Declared optional so a
         device without a camera — a head unit, a tablet in a mount — can still
         install the app; the button offers an image file instead there. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- A microphone is essential; without one the app cannot function. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true"/>

    <application
        android:label="MumbleWay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- **Off, or the engine eats the link before the app sees it.**
                 Flutter's own deep linking is on by default on Android, and it
                 treats an incoming VIEW intent as *route information*: it hands
                 the URI's path to `Navigator.pushNamed`. For
                 `mumble://host/Riders` that is a push of `/Riders`, which is
                 not a route this app has, so `onUnknownRoute` runs and throws

                     Null check operator used on a null value
                       _WidgetsAppState._onUnknownRoute

                 and the invitation is lost. Nothing about it looks like a deep
                 link problem from the outside: the intent filter below resolves
                 correctly, `MainActivity` parses the URI correctly, and
                 `DeepLinks` on the Dart side is waiting correctly. The engine
                 simply never gives any of them the intent. Confirmed on the
                 device, 2026-08-14, by firing the intent with `am start` and
                 reading the stack trace out of logcat.

                 This app routes invitations itself, through the
                 `mumbleway/links` MethodChannel, because a `mumble://` URL is
                 an address to connect to rather than a screen to open. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Invitation links, which is also how a QR code scanned by the
                 phone's own camera app reaches us: the camera recognises the
                 scheme and offers to open whatever claims it.

                 BROWSABLE is what lets a link in a web page or a message be
                 followed; without it the filter only matches intents built by
                 another app on purpose. No autoVerify and no host: this is a
                 private scheme rather than an https link, so there is no
                 domain to prove ownership of. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="mumble"/>
            </intent-filter>
            <!-- The same invitation as an ordinary https link, because
                 `mumble://` does not survive a messaging app.

                 **Measured on the device, 2026-08-15, not assumed.** Telegram
                 is inconsistent about turning a `mumble://` URL into something
                 tappable at all: one sent through the bot rendered as dead
                 plain text. And when it does linkify one, tapping it opens
                 Telegram's in-app browser, a Chrome Custom Tab, which tries to
                 *load* `mumble://` as a web address and fails. Neither can be
                 fixed from inside this app: nothing here changes what another
                 app does with the text of a message. An https link is
                 linkified by every messenger there is, and `autoVerify` is
                 what makes Android hand it to us instead of to a browser.

                 The scheme filter above stays and is not redundant: it is what
                 the phone's camera app offers for a scanned QR code, what the
                 official Mumble client publishes, and what works with no
                 network and no domain.

                 **Verification needs
                 `https://zavitax.github.io/.well-known/assetlinks.json`** to be
                 reachable anonymously, carrying this app's Play App Signing
                 fingerprint. Play re-signs every upload, so the fingerprint
                 that matters is the one on the installed artifact rather than
                 the upload key's. If that file stops being served, Android
                 silently stops treating these as app links and sends them to
                 the browser instead, which looks exactly like this feature
                 never existing.

                 The server, channel and any password ride in the URL
                 **fragment**, which browsers never send to the server. So the
                 page below is fetched without them, and no invitation ends up
                 in a GitHub access log. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="zavitax.github.io"
                      android:pathPrefix="/mumbleway/join"/>
            </intent-filter>
        </activity>
        <!-- Shows a crash instead of the app simply disappearing.

             In its own process on purpose: the process that crashed is on its
             way out and may be in any state at all, so asking it to draw its
             own error message is asking the broken thing to work. Not
             exported — nothing outside the app has any business starting it. -->
        <activity
            android:name=".CrashActivity"
            android:process=":crash"
            android:taskAffinity="com.mumbleway.mumbleway.crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"/>
        <!-- Keeps the audio engine and the overlay alive while another app is
             in front. Typed as "microphone" because Android 14 requires a
             foreground service to declare why it runs. -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So the documentation links can be opened. From Android 11 a package
             this app has not declared is invisible to it, and url_launcher then
             reports that nothing can handle an ordinary https address — which
             looks like a broken link rather than a missing manifest entry. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
