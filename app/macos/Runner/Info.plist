<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<!-- Required on macOS 10.14 and later, and the sandbox entitlement is not
	     a substitute: the entitlement decides whether the app may ask, this
	     decides whether the system lets it. Without it macOS terminates the
	     process the moment it touches the microphone, which reads as a crash
	     on connect rather than as a missing plist key. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>MumbleWay uses your microphone so you can talk to other riders.</string>
	<!-- Export compliance. True, because it is: the voice path encrypts with
	     AES-128 under OCB2, implemented in this app rather than taken from the
	     system, and the control channel runs TLS from a library compiled into
	     the binary. None of the exemptions fit — this is not HTTPS only, not
	     limited to authentication, and not encryption provided by the
	     operating system. No operating system offers OCB2, so the last of
	     those is out of reach for any Mumble client however it is built.

	     Declaring false here would be a false statement to a government
	     agency, not merely a wrong setting.

	     What this costs: App Store Connect asks for export documentation. Once
	     a self-classification report has been filed (ECCN 5D992.c, to BIS and
	     the NSA) Apple issues a compliance code, and adding that as
	     ITSEncryptionExportComplianceCode stops it asking on every build. See
	     docs/RELEASING.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
