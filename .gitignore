**/flutter/ephemeral/
**/Flutter/ephemeral/
app/windows/flutter/generated_plugin*
app/macos/Flutter/GeneratedPluginRegistrant.swift
app/macos/Flutter/Flutter-Debug.xcconfig
app/macos/Flutter/Flutter-Release.xcconfig
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner/GeneratedPluginRegistrant.*
app/linux/flutter/generated_plugin*

# --- Android ---------------------------------------------------------------
app/android/.gradle/
app/android/local.properties
app/android/key.properties
*.jks
*.keystore
app/android/app/src/main/java/io/flutter/plugins/
.cxx/

# --- Xcode / CocoaPods -----------------------------------------------------
**/Pods/
**/*.xcworkspace/xcuserdata/
**/xcuserdata/
*.mode1v3
*.mode2v3
*.perspectivev3
**/DerivedData/

# --- Editors / OS ----------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- Secrets ---------------------------------------------------------------
# The client identity certificate is generated per-install into the user's
# application-support directory. It must never end up in version control:
# Mumble servers tie account registration to it.
*.pem
identity.crt
identity.key
